@baseUrl = http://localhost:5191

### Login - run this first. The token lasts 15 minutes, so rerun it if you get 401.
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@acme.com",
  "password": "Password123"
}

###
@token = {{login.response.body.token}}

### Get all employees
GET {{baseUrl}}/api/employees
Authorization: Bearer {{token}}

### Create an employee (expect 201 Created + Location header)
# @name createEmployee
POST {{baseUrl}}/api/employees
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Laith Ghanem",
  "email": "laith@acme.com",
  "position": "Developer",
  "team": "IT",
  "active": true
}

###
@employeeId = {{createEmployee.response.body.id}}

### Get the employee you just created (uses the id from the request above)
GET {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}

### Get an employee that doesn't exist (expect 404 Not Found)
GET {{baseUrl}}/api/employees/00000000-0000-0000-0000-000000000099
Authorization: Bearer {{token}}

### Update an employee (expect 200 OK)
PUT {{baseUrl}}/api/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ali Mohammad",
  "email": "ali.m@acme.com",
  "position": "Senior Developer",
  "team": "IT",
  "active": true
}

### Check the update (email and position should be changed)
GET {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}

### Update an employee that doesn't exist (expect 404 Not Found)
PUT {{baseUrl}}/api/employees/00000000-0000-0000-0000-000000000099
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Nobody",
  "email": "nobody@acme.com",
  "position": "Developer",
  "team": "IT",
  "active": true
}

### Update with invalid data (expect 400 with validation errors)
PUT {{baseUrl}}/api/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "",
  "email": "not-an-email",
  "position": "",
  "team": "IT",
  "active": true
}

### Create with a duplicate email (the unique index rejects it; expect an error, 500 for now)
POST {{baseUrl}}/api/employees
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Someone Else",
  "email": "ali.m@acme.com",
  "position": "Developer",
  "team": "IT",
  "active": true
}

### Delete an employee (expect 200 Ok)
DELETE {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}

### Check the delete (expect 404 Not Found)
GET {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}

### Delete an employee that doesn't exist (expect 404 Not Found)
DELETE {{baseUrl}}/api/employees/00000000-0000-0000-0000-000000000099
Authorization: Bearer {{token}}

### Create another employee - the id should be a new, unique GUID
POST {{baseUrl}}/api/employees
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Omar Hassan",
  "email": "omar@acme.com",
  "position": "Technician",
  "team": "Maintenance",
  "active": true
}

### List everyone - look at the ids
GET {{baseUrl}}/api/employees
Authorization: Bearer {{token}}

### Without a token (expect 401 Unauthorized)
GET {{baseUrl}}/api/employees
