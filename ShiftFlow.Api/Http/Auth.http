@baseUrl = http://localhost:5191

### 1. Register a new organization (expect 201 Created, role = Manager)
# A random email and username keep reruns from clashing
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "Acme",
  "username": "{{$guid}}",
  "email": "{{$guid}}@acme.com",
  "password": "Password123"
}

### 2. Register an email that already exists (expect 409 Conflict)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "Acme Again",
  "username": "sara",
  "email": "sara@acme.com",
  "password": "Password123"
}

### 3. Register with invalid data (expect 400: no organization name, bad email, short password)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "",
  "username": "bad",
  "email": "not-an-email",
  "password": "123"
}

### 4. Login with correct credentials (expect 200 + token + refreshToken)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@acme.com",
  "password": "Password123"
}

### Saves the tokens from request 4 so the requests below can reuse them
@token = {{login.response.body.token}}
@refreshToken = {{login.response.body.refreshToken}}

### 5. Login with wrong password (expect 401 Unauthorized)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@acme.com",
  "password": "WrongPassword"
}

### 6. Login with an email that doesn't exist (expect 401, same as wrong password)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@acme.com",
  "password": "Password123"
}

### 7. Call a protected endpoint WITHOUT a token (expect 401)
GET {{baseUrl}}/api/employees

### 8. Call a protected endpoint WITH the token (expect 200)
# Run request 4 first so {{token}} has a value
GET {{baseUrl}}/api/employees
Authorization: Bearer {{token}}

### 9. Call with a fake token (expect 401)
GET {{baseUrl}}/api/employees
Authorization: Bearer this.is.not.a.real.token

### 10. Refresh (expect 200 + a new token and a new refreshToken)
# @name refresh
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
@newRefreshToken = {{refresh.response.body.refreshToken}}

### 11. Refresh again with the OLD refresh token (expect 401, it was rotated in request 10)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 12. Refresh with a made-up token (expect 401)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "not-a-real-refresh-token"
}

### 13. Refresh without a body field (expect 400)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{}

### 14. Logout with the current refresh token (expect 200)
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{newRefreshToken}}"
}

### 15. Refresh with the logged-out token (expect 401)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{newRefreshToken}}"
}

### 16. Logout again with the same token (expect 200, logout is safe to repeat)
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{newRefreshToken}}"
}
