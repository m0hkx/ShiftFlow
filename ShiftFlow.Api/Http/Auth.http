@baseUrl = http://localhost:5191

### 1. Register a new organization (expect 201 Created, role = Manager)
# A random email and username keep reruns from clashing
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "Acme",
  "username": "{{$guid}}",
  "email": "{{$guid}}@acme.com",
  "password": "Password123"
}

### 2. Register an email that already exists (expect 409 Conflict)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "Acme Again",
  "username": "sara",
  "email": "sara@acme.com",
  "password": "Password123"
}

### 3. Register with invalid data (expect 400: no organization name, bad email, short password)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "organizationName": "",
  "username": "bad",
  "email": "not-an-email",
  "password": "123"
}

### 4. Login with correct credentials (expect 200 + token, and a refreshToken cookie)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@acme.com",
  "password": "Password123"
}

### Saves the access token from request 4 so the requests below can reuse it
# The refresh token is an HttpOnly cookie, which the REST Client stores and resends on its own
@token = {{login.response.body.token}}

### 5. Login with wrong password (expect 401 Unauthorized)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "sara@acme.com",
  "password": "WrongPassword"
}

### 6. Login with an email that doesn't exist (expect 401, same as wrong password)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@acme.com",
  "password": "Password123"
}

### 7. Call a protected endpoint WITHOUT a token (expect 401)
GET {{baseUrl}}/api/employees

### 8. Call a protected endpoint WITH the token (expect 200)
# Run request 4 first so {{token}} has a value
GET {{baseUrl}}/api/employees
Authorization: Bearer {{token}}

### 9. Call with a fake token (expect 401)
GET {{baseUrl}}/api/employees
Authorization: Bearer this.is.not.a.real.token

### 10. Refresh (expect 200 + a new token, the cookie is rotated)
# Sends the refreshToken cookie saved by request 4. No body needed
# @name refresh
POST {{baseUrl}}/api/auth/refresh

### 11. Refresh with a made-up cookie (expect 401)
POST {{baseUrl}}/api/auth/refresh
Cookie: refreshToken=not-a-real-refresh-token

### 12. Refresh without any cookie (expect 401)
# An explicit empty Cookie header stops the saved cookie from being sent
POST {{baseUrl}}/api/auth/refresh
Cookie:

### 13. Logout (expect 200, revokes the token and clears the cookie)
POST {{baseUrl}}/api/auth/logout

### 14. Refresh after logout (expect 401, the cookie was cleared)
POST {{baseUrl}}/api/auth/refresh

### 15. Logout again (expect 200, logout is safe to repeat)
POST {{baseUrl}}/api/auth/logout
